<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Drone Spray Dues</title>
<link rel="manifest" href="manifest.webmanifest">
<meta name="theme-color" content="#0b1020"/>
<style>
  :root{--bg:#0b1020;--card:#121936;--muted:#8ea0ff;--text:#e9ebff;--accent:#7aa2ff;--danger:#ff6b6b;--ok:#4ad97b;}
  *{box-sizing:border-box} body{margin:0;background:linear-gradient(180deg,#0b1020,#0e1530);font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,sans-serif;color:var(--text)}
  .wrap{max-width:980px;margin:0 auto;padding:12px}
  .top{display:flex;gap:8px;align-items:center;justify-content:space-between;margin:8px 0 12px}
  h1{font-size:20px;margin:0;font-weight:700}
  .btn{background:#1c2552;color:var(--text);border:1px solid #27306c;padding:10px 12px;border-radius:12px;font-weight:600}
  .btn:active{transform:scale(0.98)}
  .btn.sec{background:#151c3f}
  .btn.out{background:transparent;border-color:#3a4696}
  .btn.danger{background:#3b0f18;border-color:#7a223a}
  .grid{display:grid;gap:10px}
  .card{background:var(--card);border:1px solid #1e2756;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.25)}
  .card .hd{padding:12px 14px;border-bottom:1px solid #1e2756;font-weight:700}
  .card .bd{padding:12px 14px}
  .tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
  .tab{flex:1 1 130px;text-align:center;padding:10px;border-radius:12px;background:#12193a;border:1px solid #1e2756;color:#c9d1ff}
  .tab.act{background:#1a2350;color:#fff;border-color:#334099;font-weight:700}
  label{font-size:12px;color:#b7c2ff;display:block;margin:4px 0}
  input,select,textarea{width:100%;padding:10px;border-radius:10px;border:1px solid #2a3476;background:#0f1431;color:#fff}
  textarea{min-height:88px}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  @media (min-width:760px){.row{grid-template-columns:repeat(3,1fr)}}
  table{width:100%;border-collapse:collapse}
  th,td{padding:8px;border-bottom:1px solid #242e6a}
  th{font-size:12px;text-align:left;color:#b7c2ff}
  td{font-size:14px}
  .muted{color:#9fb0ff}
  .badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:12px;border:1px solid #32419f;background:#1a2352}
  .badge.due{background:#3a1b1f;border-color:#7b2c36;color:#ffb5b5}
  .stat{padding:12px;border-radius:14px;border:1px solid #1e2756;background:#12193a}
  .stat .l{font-size:12px;color:#a3b0ff}.stat .v{font-size:18px;font-weight:800}
  .right{text-align:right}
  .flex{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
  .foot{font-size:11px;color:#aab4ff86;margin-top:6px}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <h1>🚁 Drone Spray Dues</h1>
    <div class="flex">
      <button class="btn out" onclick="backup()">Backup</button>
      <label class="btn out" style="cursor:pointer">Import<input type="file" accept="application/json" style="display:none" onchange="importJSON(this.files[0])"></label>
    </div>
  </div>

  <div class="tabs">
    <button class="tab act" data-tab="dash" onclick="openTab('dash',this)">Dashboard</button>
    <button class="tab" data-tab="farm" onclick="openTab('farm',this)">Farmers</button>
    <button class="tab" data-tab="jobs" onclick="openTab('jobs',this)">Jobs</button>
    <button class="tab" data-tab="pay" onclick="openTab('pay',this)">Payments</button>
    <button class="tab" data-tab="rem" onclick="openTab('rem',this)">Reminders</button>
    <button class="tab" data-tab="set" onclick="openTab('set',this)">Settings</button>
  </div>

  <!-- sections code cut for shortness, same as before -->
  <section id="dash" class="card">
    <div class="hd">Summary</div>
    <div class="bd">...</div>
  </section>
</div>

<script src="app.js"></script>
</body>
</html>
